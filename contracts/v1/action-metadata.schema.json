{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/action-metadata.schema.json",
  "title": "ActionMetadata",
  "description": "Registry entry for one reusable Mocap action. The planner resolves shot actor cues against this registry; unresolvable cues block the run with asset_missing instead of being improvised.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recording_id", "source_file", "duration_ticks", "start_pose", "end_pose", "source", "verified"],
  "properties": {
    "recording_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "title": { "type": "string", "maxLength": 160 },
    "source_file": {
      "type": "string",
      "pattern": "^(assets|work)/[A-Za-z0-9_./ -]+$",
      "maxLength": 240
    },
    "duration_ticks": { "type": "integer", "minimum": 1, "maximum": 24000 },
    "start_pose": { "type": "string", "maxLength": 64 },
    "end_pose": { "type": "string", "maxLength": 64 },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "mirrorable": { "type": "boolean", "default": false },
    "loopable": { "type": "boolean", "default": false },
    "interactions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "type"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "type": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "source": { "enum": ["human_recorded", "programmatic", "imported"] },
    "verified": { "type": "boolean" }
  }
}
