{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/production-plan.schema.json",
  "title": "ProductionPlan",
  "description": "Whole-film plan. Contains no free-text execution instructions: every write the production performs must be derivable from referenced, separately validated plans (scene/shot/timeline/camera/export).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "production_id", "minecraft_version", "fabric_loader", "target", "scenes"],
  "properties": {
    "schema_version": { "const": 1 },
    "production_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "minecraft_version": { "const": "1.21.1" },
    "fabric_loader": { "const": "0.19.3" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "codec"],
      "properties": {
        "width": { "type": "integer", "enum": [1280, 1920] },
        "height": { "type": "integer", "enum": [720, 1080] },
        "fps": { "type": "integer", "enum": [30, 60] },
        "codec": { "const": "h264" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "world_ref", "shots"],
        "properties": {
          "scene_id": { "$ref": "#/$defs/safe_name" },
          "world_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "blueprint_ref": {
            "type": "string",
            "pattern": "^assets/blueprints/[A-Za-z0-9_./-]+\\.json$",
            "maxLength": 200
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "$ref": "#/$defs/shot" }
          }
        }
      }
    }
  },
  "$defs": {
    "safe_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "scene_id", "duration_ticks", "actors", "recording"],
      "properties": {
        "shot_id": { "$ref": "#/$defs/safe_name" },
        "scene_id": { "$ref": "#/$defs/safe_name" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "duration_ticks": { "type": "integer", "minimum": 1, "maximum": 24000 },
        "actors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "action_ref", "start_tick"],
            "properties": {
              "actor_id": { "$ref": "#/$defs/safe_name" },
              "skin_file": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Verified local Mocap skin basename; no path or command text." },
              "action_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "description": "ActionRegistry recording_id; must resolve or the run stops at asset_missing."
              },
              "start_tick": { "type": "integer", "minimum": 0, "maximum": 24000 },
              "position": {
                "type": "array",
                "items": { "type": "integer" },
                "minItems": 3,
                "maxItems": 3
              },
              "yaw": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          }
        },
        "camera_ref": { "$ref": "#/$defs/safe_name" },
        "recording": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_roll_ticks", "post_roll_ticks"],
          "properties": {
            "pre_roll_ticks": { "type": "integer", "minimum": 0, "maximum": 600 },
            "post_roll_ticks": { "type": "integer", "minimum": 0, "maximum": 600 }
          }
        }
      }
    }
  }
}
