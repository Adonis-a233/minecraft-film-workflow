{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/operation-request.schema.json",
  "title": "OperationRequest",
  "description": "Envelope carried by every controller→bridge request. Write operations must repeat the same idempotency_key on retry so the bridge can prove single execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "operation_id", "idempotency_key", "method", "params"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_./:-]+$"
    },
    "plan_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "method": {
      "enum": [
        "bridge.health",
        "bridge.capabilities",
        "bridge.get_runtime_versions",
        "bridge.get_game_state",
        "bridge.submit_timeline",
        "bridge.get_timeline_status",
        "bridge.cancel_timeline",
        "mocap.start_recording",
        "mocap.stop_recording",
        "mocap.save_recording",
        "mocap.start_scene",
        "mocap.stop_scene",
        "mocap.get_status",
        "flashback.start_recording",
        "flashback.stop_recording",
        "flashback.await_replay_saved",
        "flashback.open_replay",
        "flashback.get_editor_state",
        "flashback.replace_camera_track",
        "flashback.set_export_range",
        "flashback.start_export",
        "flashback.get_export_status",
        "flashback.cancel_export"
      ]
    },
    "params": { "type": "object" }
  }
}
