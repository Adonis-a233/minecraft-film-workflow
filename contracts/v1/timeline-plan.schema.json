{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/timeline-plan.schema.json",
  "title": "TimelinePlan",
  "description": "Tick-scheduled event list executed by the in-game bridge on the Minecraft main thread. This is the only sanctioned replacement for Python sleep(): all ordering is expressed as ticks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timeline_id", "total_ticks", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "timeline_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "shot_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "world_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "total_ticks": { "type": "integer", "minimum": 1, "maximum": 24000 },
    "events": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "type", "payload"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0, "maximum": 24000 },
          "type": {
            "enum": [
              "assert_state",
              "game.set_time",
              "game.set_weather",
              "mocap.scene_create",
              "mocap.scene_add",
              "mocap.scene_play",
              "mocap.scene_stop",
              "flashback.start_recording",
              "flashback.stop_recording"
            ]
          },
          "payload": { "type": "object" },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
