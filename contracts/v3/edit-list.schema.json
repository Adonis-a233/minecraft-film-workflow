{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v3/edit-list.schema.json",
  "title": "EditList",
  "description": "Deterministic assembly contract (workflow v3 §7-P4): the edit is DATA, the ffmpeg invocation is generated code. Every clip references a verified export artifact by path; subtitles and audio carry absolute seconds on the OUTPUT timeline. The plan generator (agent edit.py) turns this into a fixed argv sequence — no interactive editing, no hand-timed cuts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edit_id", "output", "video_clips"],
  "properties": {
    "schema_version": { "const": 3 },
    "edit_id": { "type": "string", "pattern": "^[a-z0-9_-]{2,64}$" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height", "fps"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 400 },
        "width": { "type": "integer", "minimum": 16, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4320 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "container": { "enum": ["mp4", "mkv"] }
      }
    },
    "video_clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "take_from_seconds", "duration_seconds", "timeline_start_seconds"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 400 },
          "take_from_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "timeline_start_seconds": { "type": "number", "minimum": 0 },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "audio_clips": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "take_from_seconds", "duration_seconds", "timeline_start_seconds"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 400 },
          "take_from_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "timeline_start_seconds": { "type": "number", "minimum": 0 },
          "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
          "fade_in_seconds": { "type": "number", "minimum": 0 },
          "fade_out_seconds": { "type": "number", "minimum": 0 },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "subtitles": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_seconds", "end_seconds", "text"],
        "properties": {
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "text": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 1000 }
  }
}
