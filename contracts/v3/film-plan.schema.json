{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v3/film-plan.schema.json",
  "title": "FilmMasterPlan",
  "description": "Master production plan (workflow-gap-audit 20261008): pins the shots manifest and every chapter recipe by hash, and optionally carries the whole-film section (continuous soundtrack plus output templates). The master executor hashes everything to decide which shots to re-export, which chapters to rebuild, and whether the film must be reassembled; all outputs are freshly named and nothing is ever overwritten.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "video", "shots_manifest", "chapters"],
  "properties": {
    "schema_version": {"const": 3},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "video": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"enum": [1280, 1920]}, "height": {"enum": [720, 1080]},
        "fps": {"enum": [30, 60]}
      }
    },
    "shots_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/file"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "chapters": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {"path": {"$ref": "#/$defs/file"}, "sha256": {"$ref": "#/$defs/sha"}}
      }
    },
    "film": {
      "type": "object", "additionalProperties": false,
      "required": ["audio", "outputs"],
      "properties": {
        "audio": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "sample_rate", "channels", "decoded_pcm_sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/file"},
            "sha256": {"$ref": "#/$defs/sha"},
            "sample_rate": {"const": 48000},
            "channels": {"const": 2},
            "decoded_pcm_sha256": {"$ref": "#/$defs/sha"}
          }
        },
        "outputs": {
          "type": "object", "additionalProperties": false,
          "required": ["clean", "subtitles"],
          "properties": {
            "clean": {"$ref": "#/$defs/output_template"},
            "subtitles": {"$ref": "#/$defs/output_template"}
          }
        }
      }
    },
    "notes": {"type": "string", "maxLength": 2000}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {"type": "string", "pattern": "^(assets|work|game)/[A-Za-z0-9_./+-]+$"},
    "output_template": {
      "type": "string", "pattern": "^(assets/renders|work)/[A-Za-z0-9_./+{}$-]*\\{film_id\\}[A-Za-z0-9_./+-]*\\.mp4$",
      "maxLength": 400
    }
  }
}
