{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v3/film-chapter.schema.json",
  "title": "FilmChapterRecipe",
  "description": "Declarative chapter recipe (workflow-gap-audit 20261008): the chapter timeline is assembled from replay shots (by id, resolved through a film-shots manifest) and imported archived clips (pinned by hash); each variant burns its own ASS overlay set onto the same timeline. The chapter executor compiles this recipe into deterministic edit-list executions and publishes a review manifest carrying the inputs digest that drives staleness decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter_id", "seconds", "video", "shots_manifest", "timeline", "variants", "outputs"],
  "properties": {
    "schema_version": {"const": 3},
    "chapter_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "seconds": {"type": "integer", "minimum": 1, "maximum": 1200},
    "video": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"enum": [1280, 1920]}, "height": {"enum": [720, 1080]},
        "fps": {"enum": [30, 60]}
      }
    },
    "shots_manifest": {"$ref": "#/$defs/file"},
    "timeline": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["take_from_seconds", "duration_seconds", "timeline_start_seconds"],
        "properties": {
          "shot": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "clip": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {"path": {"$ref": "#/$defs/media_file"}, "sha256": {"$ref": "#/$defs/sha"},
                           "kind": {"enum": ["video", "image"]}}
          },
          "take_from_seconds": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "timeline_start_seconds": {"type": "number", "minimum": 0},
          "note": {"type": "string", "maxLength": 200}
        },
        "anyOf": [{"required": ["shot"]}, {"required": ["clip"]}]
      }
    },
    "audio_clips": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "take_from_seconds", "duration_seconds", "timeline_start_seconds"],
        "properties": {
          "source": {"$ref": "#/$defs/media_file"},
          "sha256": {"$ref": "#/$defs/sha"},
          "take_from_seconds": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "timeline_start_seconds": {"type": "number", "minimum": 0},
          "gain_db": {"type": "number", "minimum": -60, "maximum": 12},
          "fade_in_seconds": {"type": "number", "minimum": 0},
          "fade_out_seconds": {"type": "number", "minimum": 0},
          "note": {"type": "string", "maxLength": 200}
        }
      }
    },
    "visual_overlays": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "start_seconds", "end_seconds", "x", "y", "width", "height"],
        "properties": {
          "shot": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "source": {"$ref": "#/$defs/media_file"}, "sha256": {"$ref": "#/$defs/sha"},
          "kind": {"enum": ["image", "video"]},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "take_from_seconds": {"type": "number", "minimum": 0},
          "speed": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
          "fit": {"enum": ["stretch", "contain_black"]},
          "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
          "width": {"type": "integer", "minimum": 2}, "height": {"type": "integer", "minimum": 2}
        },
        "oneOf": [{"required": ["shot"]}, {"required": ["source", "sha256"]}]
      }
    },
    "variants": {
      "type": "object", "additionalProperties": false,
      "required": ["clean", "subtitles"],
      "properties": {
        "clean": {"$ref": "#/$defs/variant"},
        "subtitles": {"$ref": "#/$defs/variant"}
      }
    },
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["clean", "subtitles", "manifest"],
      "properties": {
        "clean": {"$ref": "#/$defs/render_output"},
        "subtitles": {"$ref": "#/$defs/render_output"},
        "manifest": {"$ref": "#/$defs/file"}
      }
    },
    "notes": {"type": "string", "maxLength": 2000}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {"type": "string", "pattern": "^(assets|work)/[A-Za-z0-9_./+-]+$"},
    "media_file": {"type": "string", "pattern": "^(assets|work|game)/[A-Za-z0-9_./+-]+$"},
    "render_output": {"type": "string", "pattern": "^assets/renders/[A-Za-z0-9_./+-]+\\.mp4$"},
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["ass_overlays"],
      "properties": {
        "ass_overlays": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {"path": {"$ref": "#/$defs/media_file"}, "sha256": {"$ref": "#/$defs/sha"}}
          }
        }
      }
    }
  }
}
