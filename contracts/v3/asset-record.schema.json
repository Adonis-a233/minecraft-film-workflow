{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v3/asset-record.schema.json",
  "title": "AssetRecord",
  "description": "Procured-asset registry entry (workflow v3 §6). Originals live read-only under assets/; processed derivatives pass acceptance in work/ BEFORE being registered as official. The record carries provenance (author/URL/license/attribution), integrity (sha256), compatibility (minecraft data version, dependencies), and scene anchors — an import that cannot name all of these is not an import, it is a guess.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "kind",
    "source",
    "target",
    "import_method",
    "registered_at"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{2,64}$"
    },
    "kind": {
      "enum": [
        "schematic",
        "map_save",
        "skin",
        "props",
        "shaderpack",
        "resourcepack"
      ]
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "source_url": {
      "type": "string",
      "maxLength": 400
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "attribution": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "data_version": {
      "type": "integer",
      "minimum": 0
    },
    "minecraft_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "maxItems": 16
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96
      },
      "maxItems": 16
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "z": {
              "type": "integer"
            }
          }
        },
        "end": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "z": {
              "type": "integer"
            }
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        }
      }
    },
    "landmarks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "position"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "z": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "import_method": {
      "enum": [
        "worldedit-schem",
        "world-save-copy",
        "resourcepack",
        "shaderpack",
        "skin-provider",
        "bridge-keep"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "registered_at": {
      "type": "string",
      "maxLength": 40
    }
  }
}
